# `sound-receive` control route. Production must use an Orchestrator WSS URL.
ORCHESTRATOR_WS_URL=wss://orchestrator.local/ws
# Keep the real trusted-LAN token outside version control.
TRUSTED_LAN_TOKEN=<trusted-lan-token-placeholder>

# RTP sink identity and UDP endpoint registered with Orchestrator.
SOUND_RTP_STREAM_ID=sound-stream-001
SOUND_RTP_BIND_HOST=0.0.0.0
SOUND_RTP_BIND_PORT=5006
SOUND_RTP_ADVERTISED_HOST=sound.example.test

# Optional envelope identifiers. Defaults: sound-receive.
SOUND_TRACE_ID=sound-receive
SOUND_SESSION_ID=sound-receive

# Optional PortAudio output device. Empty or default selects the system default.
BITNP_PLAYBACK_DEVICE=

# Health endpoint, independent of the receive runtime.
SERVICE_HEALTH_HOST=127.0.0.1
SERVICE_HEALTH_PORT=8050
